# 本地开发密钥模板 —— 复制为 .dev.vars 后填入（.dev.vars 已被 .gitignore 排除）
# 生产密钥用 npx wrangler secret put <NAME> 注入，绝不入库。

# LLM（AI 对话必需；仅 Worker 侧使用，浏览器永不接触）
ANTHROPIC_API_KEY=sk-ant-...

# Ablation 备选（可留空）
OPENAI_API_KEY=
QWEN_API_KEY=

# 会话签名（openssl rand -hex 32）
JWT_SECRET=

# 金丝雀令牌（openssl rand -hex 32）
CANARY_TOKEN_SECRET=

# ===== Telegram 开户通知（可选；不配置则不发通知） =====
# 从 @BotFather 创建 bot 后获得 token；chat_id 通过向 bot 发消息后访问
# https://api.telegram.org/bot<TOKEN>/getUpdates 读取 chat.id
TELEGRAM_BOT_TOKEN =
TELEGRAM_CHAT_ID =
