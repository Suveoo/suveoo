/* docs-tw-tm.js — 服務條款正文（繁體中文） */
window.S = window.S || {};
S.LEGAL_TM_TW = [
  {
    t: "第一條　定義與解釋",
    ps: ["為便於本條款的理解與適用，除上下文另有規定外，下列詞語具有如下含義。本條款中未定義而於《隱私政策》中已有定義的詞語（如 BankAction IR、Consent Grant、五道驗證、授權欄位、PR 等級），從其定義。"],
    ss: [
      { t: "1.1　平台 / 我們", ps: ["指 Suveoo 團隊營運的 suveoo.com 網站及關聯用戶端（合稱「本平台」）。本平台為金融科技競賽示範作品，無任何真實金融牌照或經營主體資格，亦不代理任何真實金融機構。"] },
      { t: "1.2　用戶 / 你", ps: ["指完成註冊流程並取得本平台示範帳戶的自然人，無論其以真實身份還是示範身份參與。同一信箱僅對應一個帳戶；你亦可以 16 位虛擬卡號作為登入標識。"] },
      { t: "1.3　帳戶與卡片", ps: ["「帳戶」指你在本平台開立的示範帳本，含資料、卡片、流水、持倉、任務、通知與稽核記錄；「卡片」指系統隨機產生編號（經 Luhn 校驗位演算法）的虛擬簽帳卡（4 張，網路隨機分配於銀聯/萬事達/全付通，I 或 II 類）與虛擬信用卡（1 張，萬事達），卡面、餘額與額度均為模擬，不對應任何真實支付工具。"] },
      { t: "1.4　表單通道 / AI 通道 / 任務通道", ps: ["「表單通道」指你透過頁面表單直接提交業務指令；「AI 通道」指你以自然語言經 Suveoo AI 表達意圖、由模型發起工具呼叫的方式；「任務通道」指定時任務到點由系統自動履約的方式。三通道在授權與驗證規則上完全同規——這是本平台「同規示範」的核心設計，流水中的 channel 欄位可驗證這一點。"] },
      { t: "1.5　鎖定資金（held）", ps: ["指因長程任務（如生日訂花）在履約前先行鎖定、暫不可用於其他支付的金額，在卡片上以「鎖定預算」單獨展示。任務完成則資金付出，任務取消或履約失敗則自動解鎖（補償）。"] },
      { t: "1.6　Saga 與補償", ps: ["指多步驟長程業務的編排機制：第一步資金鎖定（T1）、第二步外部履約（T2，示範中為商戶訂單）、任一後續步驟失敗時執行補償動作（C1，如資金解鎖）。步驟狀態與補償路徑記錄於任務物件，可經任務中心與故障注入示範觀察。"] },
      { t: "1.7　Trust Console", ps: ["指 AI 頁內即時展示工具呼叫全鏈路（提議、IR、各道驗證結論、執行結果）的可觀察性面板，並提供示範模式下的故障注入入口。"] },
    ],
  },
  {
    t: "第二條　服務性質——模擬系統聲明",
    ps: ["2.1　本平台為模擬銀行系統：全部帳戶、卡片、餘額、交易對手、流水、基金淨值、存款利率與外匯牌價均為隨機產生的示範資料，不涉及任何真實資金劃轉、真實帳戶開立或真實金融產品交易。2.2　本平台不以任何形式吸收公眾存款、發放貸款、銷售真實理財、辦理支付結算或徵信業務；你在本平台的一切「資產」與「收益」均無真實貨幣價值，不可提取、不可兌現、不可轉讓、不可質押。2.3　本平台在顯著位置標註「這是模擬銀行系統，不涉及真實資金行為」，該標註屬於本條款的組成部分，頁面頁尾常駐同義聲明。2.4　本平台與任何真實銀行、券商、基金公司或支付機構不存在任何隸屬、合作或代理關係；名稱、卡面與網路標識的相似性純屬示範需要，不構成任何關聯暗示。2.5　示範資料的產生規則：註冊時隨機發卡（餘額合計約 ¥100 万量级）、示範帳戶預置約 269 筆歷史流水與生日訂花任務（鎖定 ¥600）等情境資料；全部資料可經重置重建。"],
  },
  {
    t: "第三條　服務主體與能力邊界",
    ps: ["3.1　本平台由 Suveoo 團隊（競賽參賽團隊）作為示範作品提供，不構成《商業銀行法》《證券法》《期貨和衍生品法》等法律意義上的金融服務提供者，與用戶之間不成立任何金融消費服務關係。3.2　本平台展示的技術架構（Agentic Banking Control Plane、BankAction IR、五道驗證、Saga 補償、確定性驗證執行環境等）屬於工程示範與學術交流範疇，不構成對任何真實機構的部署建議、合規建議或投資建議。3.3　你理解並同意：基於本平台得出的任何研究、評測或商業結論，均應自行驗證，本平台不對該等結論的準確性承擔責任。3.4　本條款不創設任何第三方受益人權利；除你與本平台外，任何人不得援引本條款主張權利。"],
  },
  {
    t: "第四條　註冊與資格",
    ps: ["4.1　註冊方式：有效信箱 + 一次性驗證碼（10 分鐘有效、5 次嘗試上限）+ 設定密碼（8–32 位）+ 完成八題風險測評 + 確認反洗錢（AML）聲明。AML 聲明在示範語境下僅用於示範開戶合規流程，不產生真實法律義務，但你仍應作出真實承諾——這一示範恰用於說明真實開戶中該環節的嚴肅性。4.2　資格：本平台面向競賽評審與成年示範用戶；未成年人不得註冊（見《隱私政策》第十一條）。4.3　資訊要求：你應保證註冊資訊不侵犯他人權益；姓名可使用化名（示範特性），但不得冒用真實他人身份並宣稱係其本人，不得使用侵犯他人商標或姓名權的標識。4.4　驗證碼送達：郵件經 Cloudflare Email Service 自 noreply@suveoo.com 發出，受 60 秒重發冷卻與小時級頻控（5 封/小時）約束；請檢查垃圾郵件資料夾。因你方信箱服務商拒收、延遲所致的送達問題，不屬於本平台過錯。4.5　請勿向任何人揭露驗證碼與密碼——本平台工作人員永遠不會向你索取驗證碼。"],
  },
  {
    t: "第五條　帳戶安全與你的義務",
    ps: ["5.1　憑證保管：你應妥善保管密碼與登入會話（會話權杖有效期 1 小時，登出即時撤銷）；經你的會話發起的操作，視為你本人行為（系統被入侵等相反證據除外）。5.2　兩步驗證：你可開啟 2FA（信箱驗證碼）；開啟後登入需額外驗證，敏感操作要求更強驗證。5.3　異常報告：發現未授權操作或安全漏洞的，應立即透過 security@suveoo.com 報告；對負責任揭露的漏洞，本平台將在致謝名單中致謝（如你願意）並說明修復時間線。5.4　不得共享帳戶：示範帳戶不得出借、共享或用於自動化壓測（後者見第十二條）。5.5　安全示例義務：不要在公共裝置勾選記住密碼；不要將會話權杖貼上至任何第三方工具；發現餘額或流水異常時先凍結卡片（紅色操作）再核查。"],
  },
  {
    t: "第六條　卡片與額度",
    ps: ["6.1　開戶時系統隨機產生 4 張簽帳卡（餘額隨機合計約 ¥100 万量级）與 1 張信用卡（額度 ¥320,000），卡號經 Luhn 校驗位演算法產生、全域唯一。6.2　卡片狀態機為 ACTIVE 與 FROZEN 兩態：凍結與解凍均為紅色操作（需 OTP）；凍結卡片不可作為轉帳付款卡。6.3　每卡帶單筆限額與單日限額（預設 ¥50,000 / ¥100,000，可經黃色確認流程調整），信用卡另有總額度與「可用額度 = 額度 − 欠款」的展示口徑；還款日與帳單日為固定示範值（每月 10 日 / 20 日），不產生真實息費。6.4　卡片支援別名、設為預設卡，以及示範性地理圍欄開關（開啟後境外無卡交易可用 7 天，限額調至 ¥3,500/天，到期自動回收，屬 TTL 示範特性）。6.5　卡片僅在本平台內部閉環使用，不能用於任何外部消費情境，卡號不可用於任何真實註冊或支付。"],
  },
  {
    t: "第七條　交易規則與授權分級",
    ps: ["本條是本條款的核心，規定了任何資金變動操作的統一規則；本條與《隱私政策》第六條的錯誤碼語義表配合閱讀。"],
    ss: [
      { t: "7.1　三色分級", ps: ["綠色操作（帳戶查詢、帳單分析、聯絡人檢索、外匯牌價、AA 分帳計算等唯讀行為）自動執行，無需確認；黃色操作（行內轉帳、限額調整、帳單繳費、訂閱取消、收款人維護、定時任務建立、外匯兌換等）須經你確認；紅色操作（單筆或日累計達到閾值的轉帳、基金申購贖回、存款開戶、卡片凍結解凍、密碼修改等）須經強驗證（兩段式確認 + 信箱 OTP）。分級由伺服器策略引擎按操作類型與金額動態判定（基礎等級 + 日累計越閾升級），用戶端展示不構成分級依據。"] },
      { t: "7.2　兩段式確認與 Consent Grant", ps: ["黃色與紅色操作在首次提交時返回參數快照與授權雜湊（grant_hash，120 秒有效），你不確認則操作不生效；確認時系統將本次提交參數與快照逐一比對，任何不一致都會導致授權失效（CONSENT_INVALIDATED）。Grant 與帳戶綁定、一次性消費：重複提交返回 GRANT_ALREADY_USED，偽造返回 GRANT_NOT_FOUND，跨帳戶盜用同樣返回 GRANT_NOT_FOUND（不洩露存在性）。"] },
      { t: "7.3　紅色操作與 OTP", ps: ["紅色操作在確認環節之外還要求一次性信箱驗證碼（scene=redstep，10 分鐘有效、5 次嘗試）：錯誤驗證碼不消耗原驗證碼記錄但計入嘗試次數；篡改判定優先於 OTP 校驗，確保「先驗證你同意的是什麼，再驗證你是不是你」。取得驗證碼受 60 秒冷卻與小時頻控約束。"] },
      { t: "7.4　金融不變量", ps: ["執行前逐項校驗：餘額充足性（可用餘額 = 餘額 − 鎖定資金 ≥ 金額）、帳戶與卡片狀態（ACTIVE）、適當性（產品 R 等級 ≤ 你的 PR 等級，違反即 APPROPRIATENESS_MISMATCH）、外匯額度（fx_quota_remaining ≥ 兌換金額）等；不滿足即拒絕並給出對應錯誤碼。"] },
      { t: "7.5　冪等與重放", ps: ["每筆操作攜帶唯一 nonce；已消費的 nonce 與 grant 均不可復用，重放將被拒絕（REPLAY_DETECTED / GRANT_ALREADY_USED），且重放不產生二次扣款。"] },
      { t: "7.6　限額體系", ps: ["（一）卡片級：單筆與單日限額（預設 ¥50,000 / ¥100,000，黃色流程可調）；（二）AI 通道硬限額：單筆 ¥5,000、單日 ¥10,000，僅約束轉帳與外匯兩類授權操作，策略階段即拒（AI_SINGLE_LIMIT_EXCEEDED / AI_DAILY_LIMIT_EXCEEDED）；（三）黃色→紅色動態升級：當日累計轉出金額越閾即升級為紅色強驗證。以上限額均為示範參數，用於展示「通道差異化風控」。"] },
      { t: "7.7　失敗與補償（Saga）", ps: ["長程業務（如生日訂花）按 T1 資金鎖定 → T2 商戶履約編排；T2 失敗時自動執行 C1 資金解鎖補償，任務標記 COMPENSATED。你可在任務中心對示範任務注入故障（僅示範模式可用）觀察補償全鏈路；定時任務另有到期掃描備援（sweepDue），即使排程事件遺失亦會在任務清單讀取時補履約。"] },
      { t: "7.8　回執、追蹤與郵件通知", ps: ["每筆成功操作產生唯一流水號（TX 前綴）與追蹤號（bai_ 前綴），可在轉帳記錄與稽核日誌中核對；行內轉帳完成後，轉出方與轉入方（如配置信箱）均收到郵件通知，備註內容將包含在郵件中。AI 通道操作可在 Trust Console 查看全鏈路驗證事件。"] },
    ],
  },
  {
    t: "第八條　Suveoo AI 智慧體服務",
    ps: ["8.1　能力邊界：Suveoo AI 僅能經由 23 個註冊工具發起業務「提議」，絕無直接執行權限；一切變更須經第七條所列流程。工具呼叫往返由本平台程式碼編排（上限 8 輪），不依賴模型服務商的任何「伺服器代連」特性——這保證更換任何模型供應商時該部分邏輯零改動。8.2　模型供應商：對話由阿里雲百煉·通義千問（Anthropic 相容介面，模型名 qwen3.6-flash）處理，詳見《隱私政策》第六條。8.3　輸出免責：模型可能對查詢結果作出概括或解讀，該等內容不構成投資建議；當模型輸出與工具返回的確定性資料不一致時，以工具返回為準。8.4　攔截與失敗：五道驗證對 AI 提議的攔截（包括因提示注入、參數篡改、來源污點或限額所致）屬於安全機制的正常工作，本平台不因攔截本身對任何「預期利益」承擔責任；攔截原因碼如實在工具結果中返回。8.5　示範性故障注入：Trust Console 提供「注入故障」按鈕（僅示範模式可用），用於示範 Saga 補償機制；該功能僅影響示範資料，不構成平台缺陷。8.6　會話隔離：每個會話獨立維護上下文與歷史；你可隨時發起新會話以隔離上下文，舊會話歷史按《隱私政策》第八條約定的期限處理。"],
  },
  {
    t: "第九條　財富管理服務（基金與存款）",
    ps: ["9.1　本平台展示 8 隻模擬基金（R1 貨幣型至 R5 權益型，含淨值走勢、風險等級、費率、最低申購額、持倉構成與基金經理資訊）與 6 類存款方案（活期、7 天通知、3 月、6 月、1 年、3 年），全部淨值、收益率與利率為靜態示範資料。9.2　申購與贖回為紅色操作，須完成兩段式確認與 OTP；申購前系統執行適當性校驗（產品 R 等級 ≤ 你的 PR 等級），不匹配即拒絕（APPROPRIATENESS_MISMATCH），介面亦會預先提示不匹配風險。9.3　持倉市值按「本金 × 當前淨值 ÷ 成本淨值」近似計算，用於示範資產總覽與儀表板；「今日收益」為基於模擬淨值的近似浮盈。9.4　本平台及其內容不構成任何投資建議或收益承諾；「歷史業績」均為編造資料，不代表任何真實產品的未來表現；存款計算機輸出為單利示範口徑。"],
  },
  {
    t: "第十條　外匯服務",
    ps: ["10.1　外匯牌價提供 10 個幣別的買入/賣出/中間價與 7 日走勢（靜態示範資料）；兌換交易為黃色操作，須兩段式確認。10.2　模擬年度換匯額度（$50,000 等值）用於示範額度不變量校驗，額度不足即拒絕；耗用資料僅為示範。10.3　示範匯率與任何真實市場報價無關；兌換計算機支援雙向換算，結果以中間價示範口徑計算。"],
  },
  {
    t: "第十一條　費用與息費",
    ps: ["11.1　本平台全部操作免手續費（轉帳確認卡中「手續費 ¥0.00」為固定展示）；存款利率、貸款計算機利率均為示範值，貸款結果為等額本息口徑。11.2　不存在任何真實收費項目；如未來示範需要引入收費情境（如展示費用透明度功能），將以顯著方式提示且不涉及真實資金。"],
  },
  {
    t: "第十二條　用戶行為規範",
    ps: ["12.1　你承諾不利用本平台從事下列行為：（一）違反任何適用法律法規；（二）對平台實施或協助實施拒絕服務攻擊、爬蟲壓測、自動化批量註冊或繞過頻控；（三）攻擊驗證體系之外的系統組件（如嘗試存取儲存原語、篡改靜態資產、掃描基礎設施）；（四）冒用他人身份或宣稱示範資料為真實資料；（五）將本平台內容用於誤導性宣傳（如宣稱真實收益、偽造合作關係）。12.2　歡迎的安全研究：在負責任揭露框架下（security@suveoo.com），我們鼓勵針對驗證體系本身的對抗測試——包括同意篡改、越權、重放與提示注入——這正是本平台的設計示範目標；請將嘗試限制在不影響服務可用性的範圍內。12.3　違反上述規範的，本平台可採取限流、鎖定、刪除資料等措施，並在競賽評審材料中如實記錄濫用情形。"],
