{
  "name": "suveoo-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Suveoo Agentic Banking Control Plane - single Cloudflare Worker (suveoo-bank-main)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail suveoo-bank-main",
    "test": "vitest run",
    "test:watch": "vitest",
    "upload:frontend": "node scripts/deploy-frontend.mjs",
    "seed": "node scripts/seed-demo-data.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "agents": "^0.23.0",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1"
  }
}
