/* docs-zh-pri.js — 隐私政策正文（简体中文） */
window.S = window.S || {};
S.LEGAL_PV_ZH = [
  {
    t: "第一条　定义与解释",
    ps: ["为便于本政策的理解与适用，除上下文另有规定外，本政策中的下列词语均具有本条所确立的含义。凡援引任何一款定义的条款，其含义均以本条为准；就同一词语在本政策不同位置出现的，其含义保持一致。本政策大量使用工程术语以保持与系统实现的一致性——评审者可将本条作为代码库（worker-main.js 与 frontend/ 目录）的阅读索引。"],
    ss: [
      { t: "1.1　本平台", ps: ["指由 Suveoo 团队开发与运营、域名为 suveoo.com 的网站及其渐进式 Web 应用（PWA）安装实例，前端为无构建多页应用（MPA，约 50 个静态页面，经 Service Worker 提供应用壳预缓存与离线兜底），后端为单一 Cloudflare Worker（worker-main.js）加两类 Durable Object（账本 LedgerDO 与任务 SagaDO）、两桶 KV（会话/授权 SESSION_KV 与内容 KV）、一个 R2 存储桶（静态资产）以及 Cloudflare Email Service（交易与验证码邮件）。本平台是面向金融科技竞赛评审与公众开放的银行智能体（Agentic Banking）演示系统，全部账户、卡片、余额、交易、理财产品与汇率均为随机生成的模拟数据。"] },
      { t: "1.2　个人信息", ps: ["指以电子或者其他方式记录的与已识别或者可识别的自然人有关的各种信息，不包括匿名化处理后的信息。本政策采用《中华人民共和国个人信息保护法》（下称「PIPL」）第四条的界定标准，并在涉及与欧盟《通用数据保护条例》（GDPR）对应概念时附注其英文术语（personal data）。"] },
      { t: "1.3　敏感个人信息", ps: ["指一旦泄露或者非法使用，容易导致自然人的人格尊严受到侵害或者人身、财产安全受到危害的个人信息，包括生物识别、宗教信仰、特定身份、医疗健康、金融账户、行踪轨迹等信息（PIPL 第二十八条；对应 GDPR 第九条 special categories of data）。本平台不主动收集任何真实敏感个人信息；如你自愿在本平台输入此类信息，我们将按不低于敏感信息的标准予以处理与保护。"] },
      { t: "1.4　授权字段", ps: ["指在转账、外汇兑换、申购赎回等授权型操作中，直接决定资金流向、币种与金额的字段，典型如收款人（recipient）、金额（amount）、币种（currency）、产品编号（product_id）。每类授权型操作在服务端工具模式（TOOL_SCHEMA）中登记了其授权字段清单（authFields，例如转账为 recipient、amount、currency 三项）与前置条件（preconditions）。授权字段的精确取值构成 Consent Grant 绑定快照的组成部分；任何变更（无论由谁发起、动机为何）都将导致先前授权即时失效（错误码 CONSENT_INVALIDATED）。"] },
      { t: "1.5　BankAction IR", ps: ["指本平台将用户意图（无论来自表单通道还是 AI 通道）经编译器 compileToIR() 生成的银行动作中间表示（BankAction Intermediate Representation），固定包含：ir_version、trace_id（bai_ 前缀追踪号）、nonce（一次置随机数）、user_id、channel（form/ai/task）、model（AI 通道记录所用模型供应商）、intent（意图）、facts（字段级事实数组，每项含 field、value、provenance、trust 四元组）、risk（三色分级与理由）、preconditions 与 compensation（补偿动作清单）、created_at 与 expires_at。IR 是五道确定性验证的唯一输入，亦是所有写账操作的唯一依据：不存在任何绕过 IR 直接改写账本的代码路径。"] },
      { t: "1.6　Consent Grant（同意绑定）", ps: ["指你在确认环节对某一精确参数快照作出的授权承诺，以 64 位十六进制授权哈希（grant_hash）唯一标识。其生成算法为：对「意图 ‖ 授权字段取值 ‖ 用户标识 ‖ 过期时间 ‖ 随机数」串接后取 SHA-256。其效力特征为：与你的账户身份绑定（他账户不可盗用）、短时效（默认 120 秒）、一次性消费（消费后立即标记并缩短剩余存储时间）、参数快照比对（确认时逐字段与首次提交比对）。该机制是本平台「AI 只能提议、验证决定执行」安全模型的组成部分。"] },
      { t: "1.7　五道验证", ps: ["指本平台对每一笔待执行操作依次实施的确定性校验：策略分级（Policy，含硬性拒绝规则与 AI 通道单笔/单日限额）、同意绑定（Consent）、来源污点（Provenance）、金融不变量（Invariants）与幂等重放（Replay）。验证结论逐道记录（通过/不通过/跳过/待输入），任一道不通过即拒绝执行（错误码形如 POLICY 阶段 INVALID_AMOUNT、CONSENT 阶段 GRANT_NOT_FOUND、PROVENANCE 阶段 UNTRUSTED_PROVENANCE、INVARIANTS 阶段 INVARIANT_BALANCE、REPLAY 阶段 REPLAY_DETECTED），不产生任何账务变更。全部结论在 AI 通道可于 Trust Console 实时观察。"] },
      { t: "1.8　匿名化与去标识化", ps: ["匿名化（anonymization）指经处理后无法识别特定自然人且不能复原的过程；去标识化（de-identification）指借助额外信息无法识别特定自然人的过程。本政策依 PIPL 第七十三条区分二者。本平台的典型实践为：界面展示中卡号掩码（**** 6742）、邮箱掩码（de**@suveoo.com）、追踪号在信任事件流中截断展示（grant 前缀 12 位）。"] },
      { t: "1.9　处理者、受托处理者与第三方", ps: ["处理者（controller）指决定处理目的与方式的主体；受托处理者（processor）指受处理者委托代为处理的主体。就本平台而言：Suveoo 团队为处理者；模型服务商（第六条）就对话内容而言为受托处理者或独立处理者（以其服务条款为准）；Google（GA4 分析，经你同意后启用）为独立处理者。"] },
      { t: "1.10　存储原语", ps: ["KV（键值存储）：存放会话、验证码、授权绑定、对话历史等有 TTL 的键值数据；Durable Object（含 SQLite）：存放账本、资料、流水、任务等结构化数据，按「注册表单例 + 每用户实例」隔离，天然实现用户间数据边界；R2 对象存储：存放静态资产（页面、脚本、样式、图标、字体、图片与语言包），不含用户数据（月度报告 PDF 按请求生成、经响应流交付，不落桶）。"] },
    ],
  },
  {
    t: "第二条　政策适用范围",
    ps: ["本政策阐明本平台在你使用其全部服务的过程中，如何收集、存储、使用、加工、传输、提供、保护及（在符合条件时）删除你的个人信息。请你在使用本平台前仔细阅读本政策，重点阅读第三条（收集清单）、第六条（AI 与模型服务商）、第八条（保存期限）与第十条（你的权利），并在充分理解其内容后再作是否使用的决定。"],
    ss: [
      { t: "2.1　适用的服务范围", ps: ["本政策适用于本平台提供的全部页面与功能，包括但不限于：主页与资产总览、Suveoo AI 对话（含 Trust Console 与长程任务中心）、行内转账与预约转账、转账记录与限额、账单与订阅管理、常用收款人、财富管理（基金、存款、外汇与金融计算工具）、卡片管理与单卡设置、仪表盘与 AI 月度解读、SuveooBench 评测看板、月度报告下载、通知中心、安全中心、帮助中心与联系我们，以及全部业务通道（表单通道、AI 通道与定时任务通道）。"] },
      { t: "2.2　不适用的情形", ps: ["本政策不适用于：与本平台存在链接关系但由第三方独立运营的网站、应用与服务（此类主体对信息的处理适用其自身的隐私政策）；用户在与本平台无关的场景下自行向第三方披露的信息；竞赛评审系统内部对公开提交材料的处理。"] },
      { t: "2.3　法律参照的性质", ps: ["本平台为竞赛演示系统，本政策在结构与措辞上参照了 PIPL、网络安全法、数据安全法以及 GDPR 的立法原则与行业最佳实践（如渣打、汇丰、星展等机构公开隐私政策的章节体例），以此作为工程治理与文档规范的参照系。此类参照不产生任何真实法律效力，不构成法律意见，亦不意味着本平台受任何特定司法辖区金融监管规则的实质约束。"] },
      { t: "2.4　关联文档", ps: ["本政策与下列文档共同构成完整的治理文本体系：《服务条款》（交易与责任规则）、《Cookie 政策》（Cookie 细节）、帮助中心「AI 安全」小节（五道验证的用户侧说明）、以及代码仓库内的《安全自评估》与《核心算法》文档（技术细节，含对抗测试证据）。冲突时的适用顺序为：就信息处理事项以本政策为准，就交易与责任事项以《服务条款》为准。"] },
    ],
  },
  {
    t: "第三条　我们如何收集你的个人信息",
    ps: ["我们仅为实现本政策第五条所列目的而收集信息，并遵循目的明确、方式合理与最小必要原则（参照 PIPL 第六条）。本条按收集场景逐项列明信息类别与字段级细节，所列字段名与系统实现一一对应。"],
    ss: [
      { t: "3.1　你主动提供的信息", ps: ["（一）注册与开户：注册请求包含邮箱（email）、邮箱验证码（code）、姓名（name，可使用化名，仅作展示，长度上限 40 字符）、密码（password，8–32 位，经 PBKDF2-SHA256 迭代 100,000 次加盐后仅存哈希，任何人员均无法还原）、风险测评答案（risk_answers，8 个 1–5 的整数，用于均值折算风险承受等级 PR1–PR5）与 AML 声明确认标记（aml_consented，必须为 true 方可开户）。（二）业务操作：转账收款人名称与 16 位行内账号（或收款人引用 payee:id / 本人卡引用 self:slug）、转账备注（最长 60 字符，仅展示并随邮件通知）、收款人分组、卡片别名、卡片限额目标值、基金申购赎回金额、外汇兑换方向与金额、定时任务的执行时间与重复规则、计算器输入（纯前端计算，不出站）。（三）沟通渠道：通过「联系我们」提交的姓名、邮箱、分类与留言（经服务端校验后写入通知，用于演示答复闭环）。"] },
      { t: "3.2　你使用服务过程中形成的信息", ps: ["账户体系内的全部记录均为系统随机生成的虚拟数据。账本采用「注册表单例 + 每用户 Durable Object（SQLite）」结构，核心表与关键字段为：profile（user_id、email、name、pr_level、twofa_enabled、status、password_hash、created_at）；cards（slug、number、network、kind、balance_cents、limit_cents、held_cents、limit_single、limit_daily、is_default、status、alias）；tx（id、ts、amount_cents、direction、counterparty、memo、status、channel、trace_id、category）；payees（name、account、group_label、email）；bills 与 subscriptions（含 autopay、usage_score、dark_pattern_note 等演示字段）；holdings（fund、amount_cents、cost_nav）；fx_balances；tasks（type、title、payload、status、next_run_at、repeat）；notifications；user_audit（action、detail、channel、trace_id、ts）；nonces（幂等集合）；chats（会话标题索引）。注册时系统随机生成卡片方案（网络于银联/万事达/全付通间分配、卡号经 Luhn 校验位算法生成、余额随机合计约 ¥100 万量级）。"] },
      { t: "3.3　设备与日志信息", ps: ["为保障服务可用性、实施限流与滥用防护，我们记录基础请求日志（请求时间、来源 IP、User-Agent、路径与状态码）、服务端结构化事件（logEvent：级别、事件名、上下文）与页面性能指标（Web Vitals 类指标仅在本端计算，不出站）。日志不用于用户行为画像；仅在发生可疑事件（如连续登录失败、异常频控触发）时人工复核。"] },
      { t: "3.4　AI 对话信息", ps: ["你与 Suveoo AI 的对话内容、系统分配的会话标识（sid）、对话历史（KV 键 aihist:{sid}，随会话保留）以及工具调用全链路记录（所调用工具、参数、各道验证结论、执行结果，经 airing:{sid} 事件环实时推送至 Trust Console）。发往模型服务商的单次请求由四部分组成：系统提示词（含七条行为规则，见第六条）、会话上下文消息、23 个工具的名称与参数模式（由 MCP 工具注册表生成）、以及工具执行结果。对话不写入账本，亦不参与风控画像。"] },
      { t: "3.5　Cookie 与本地存储清单", ps: ["Cookie（共 3 项，全部为一方 Cookie）：suveoo_lang（语言偏好，1 年）、suveoo_cookie_consent（同意状态 all/necessary，1 年）；会话令牌不写 Cookie，存于 localStorage（键 suveoo_token，JWT，1 小时过期，可随时登出吊销）。KV 侧与你会话相关的键及 TTL：code:{scene}:{email}（验证码哈希，10 分钟）、cd:{scene}:{email}（60 秒重发冷却）、hr:{scene}:{email}（小时级频控计数）、grant:{uid}:{hash}（同意绑定，120 秒）、bl:{jti}（已吊销会话列表）、aihist:{sid} 与 airing:{sid}（对话历史与事件环）。分析类 Cookie（GA4，G-KLK499CDQF）默认关闭，仅当你在 Cookie 偏好中明确选择「接受全部」后启用，可随时撤回；详情另见《Cookie 政策》。"] },
      { t: "3.6　我们不收集的信息", ps: ["本平台不收集：真实身份证件或护照影像（证件上传交互仅为演示流程展示，点击即完成跳过，不产生任何上传）、真实银行账号或支付工具信息、精确地理位置、通讯录、相册、生物识别信息、真实征信信息、广告标识符。前端资源（字体 Inter / Noto Sans SC / TC / Mono、图标、图片）全部自托管于本平台 R2，除 GA4（经你同意）外不向任何第三方域名发起请求。"] },
    ],
  },
  {
    t: "第四条　处理的法律依据",
    ps: ["参照 PIPL 第十三条所列合法性基础框架（并对照 GDPR 第六条的处理依据类型以保持治理口径一致），我们对你的个人信息实施的各项处理活动及其依据映射如下。该映射同时用于内部合规自查：任何新增功能必须先归入某一依据方可上线。"],
    ss: [
      { t: "4.1　基于你的同意（consent）", ps: ["注册开户与风险测评（以 AML 声明确认为前置）、分析类 Cookie 的启用、以邮箱接收交易与验证码通知、以及本政策所列其他以你明示选择为前提的处理。你有权随时撤回同意（见第十条 10.4）；撤回不影响撤回前基于同意已进行的处理的效力。"] },
      { t: "4.2　为订立与履行服务合同所必需（contract）", ps: ["包括：创建与维护账户、校验并执行你已完成同意绑定的交易、维护卡片与持仓状态、展示资产与流水、生成交付凭证（交易回执、月度 PDF 报告）、发送交易双方的通知邮件。离开此类处理，本平台将无法向你提供相应功能；你拒绝提供此类信息等同于选择不使用相应功能。"] },
      { t: "4.3　为维护系统安全与稳定所必需（legitimate interest，限于安全目的）", ps: ["包括：登录失败限流与 15 分钟锁定（连续 5 次）、验证码尝试次数控制（单码 5 次、小时级 5 封频控）、提示注入与参数篡改防护、幂等重放检测（nonce 集合）、AI 通道限额、安全审计与事件响应。此类处理不形成个人画像，仅在发生可疑事件时人工复核，复核记录写入审计日志。"] },
      { t: "4.4　不存在其他依据", ps: ["除上述三类外，本平台不存在基于履行法定义务、应对公共卫生事件、公共利益实施新闻报道等情形的处理活动，亦不进行任何自动化信用评估或用户画像。"] },
    ],
  },
  {
    t: "第五条　我们如何使用你的信息",
    ps: ["我们对你个人信息的使用严格限定于收集时所明示的目的，并采取对个人权益影响最小的方式与范围。本条同时披露产品内全部度量（分析）事件清单，做到「每一个出站信号都有名有姓」。"],
    ss: [
      { t: "5.1　使用目的清单", ps: ["（一）创建并维护你的账户、虚拟卡片与账本数据；（二）校验并执行你明确确认的转账、兑换、申购、订阅、任务等操作并生成交付凭证；（三）驱动 Suveoo AI 理解你的自然语言请求并发起工具调用提议；（四）生成消费洞察（分类占比、异常交易标记）、月度报表与系统通知；（五）按 8 题答案均值折算（四舍五入并收敛于 1–5）维护你的风险承受等级 PR1–PR5；（六）保障交易安全、实施反滥用与反注入防护；（七）改进产品功能与演示效果。"] },
      { t: "5.2　最小必要与目的限定", ps: ["任何功能仅处理其实现所必需的字段，服务端按意图硬编码所需字段，不做通用透传。例如：转账功能不读取你的持仓数据；账单分析不读取任务列表；AI 对话中的金额、收款人等授权字段必须来源于你的明示输入，凡取值于外部文本（如交易备注中的指令性文字）的，一律被污点标记为不可信来源（trust=EXTERNAL_UNTRUSTED）并拒绝进入授权环节（UNTRUSTED_PROVENANCE）。"] },
      { t: "5.3　度量事件清单", ps: ["在你同意分析 Cookie 后，本平台仅上报以下命名事件（经 GA4，Consent Mode v2 管控，默认 denied）：page_view（页面浏览）、ai_chat_start（发起 AI 对话，附入口来源）、transfer_submit（提交转账，附金额）、transfer_confirm（确认转账）、consent_grant（同意行为，附模式 all/necessary）、sign_up（完成注册）。除金额外不含任何账户标识；金额用于聚合分析转化，不与身份关联。"] },
      { t: "5.4　关于自动化决策", ps: ["五道验证为确定性规则引擎，不涉及对你的个性化画像评估，亦不会作出可能对你人格尊严或财产权益产生重大影响的自动化决策。风险测评仅折算风险承受等级并决定你可申购产品的风险上限（适当性校验：产品 R 等级必须不高于你的 PR 等级），你可以随时在安全中心重新测评以更新结果。"] },
      { t: "5.5　展示与去标识", ps: ["在界面与邮件展示中，卡号、账号以掩码形式呈现（**** 后四位），邮箱在确认卡与 OTP 区块中掩码呈现；完整值仅在你具备有效会话的必要场景下在服务端使用。"] },
    ],
  },
  {
    t: "第六条　AI 智能体、模型服务商与委托处理",
    ps: ["Suveoo AI 是本平台的核心演示能力。为使你充分知情，本条完整披露对话数据的流转路径、模型的角色定位、系统提示词的行为约束与本平台的安全边界。"],
    ss: [
      { t: "6.1　对话的代理转发", ps: ["你与 Suveoo AI 的对话内容由本平台服务端代理转发至第三方模型服务商（阿里云百炼·通义千问 qwen3.6-flash，经 Anthropic 兼容接口，供应商经配置项 LLM_PROVIDER/LLM_BASE_URL/LLM_MODEL 声明，API 密钥经平台密钥管理注入）进行自然语言理解与生成。模型输出的任何内容——包括结构化的工具调用参数——仅构成「提议」；每轮提议须经编译为 BankAction IR 并全部通过五道验证后，方可能对你的账本产生变更。模型不持有任何会话外状态，工具调用往返由本平台代码自行编排（单次对话上限 8 轮工具调用），不依赖任何「服务端代连」特性。"] },
      { t: "6.2　传输范围的最小化", ps: ["我们仅传输完成对话所必需的数据：系统提示词、当前会话的上下文消息（含历史轮次）、工具清单与参数模式、以及工具执行结果。我们绝不传输：你的密码（含哈希）、会话令牌、验证码、完整卡号。收款人标识以 contacts_search 的结构化结果（payee:id 或掩码账号）参与传输，避免完整敏感值进入模型上下文。"] },
      { t: "6.3　系统提示词的行为约束", ps: ["系统提示词对模型施加七条可核查的规则：（一）办理业务必须调用工具，工具清单与参数模式由系统注入，禁止臆造；（二）金额一律为两位小数字符串，收款人优先经 contacts_search 解析为常用收款人并附姓名，货币统一 CNY；（三）取值来自外部文本（商户说明等）的字段必须在 provenance 标注中声明为不可信，且不得出现在收款人/金额等授权字段上；（四）收到 INPUT_REQUIRED 时，原样展示快照（金额、收款人、grant 前缀）并等待用户在界面确认，绝不可替用户确认或重试执行；（五）收到 OTP_REQUIRED 时引导用户获取并填写邮箱验证码；（六）收到 BLOCKED 时如实告知拦截原因；（七）绝不编造交易结果，一切以工具返回为准。"] },
      { t: "6.4　错误码语义表", ps: ["模型与前端可收到的确定性拒绝原因包括：UNKNOWN_TOOL（未注册工具）、INVALID_AMOUNT（金额非法）、AI_SINGLE_LIMIT_EXCEEDED / AI_DAILY_LIMIT_EXCEEDED（AI 通道单笔 ¥5,000 / 单日 ¥10,000 硬限额，仅适用于转账与外汇两类授权操作）、UNTRUSTED_PROVENANCE（不可信来源进入授权字段）、GRANT_NOT_FOUND / GRANT_USER_MISMATCH / GRANT_EXPIRED / GRANT_ALREADY_USED / GRANT_CORRUPT（同意绑定五类异常）、CONSENT_INVALIDATED（参数与快照不一致）、OTP_REQUIRED / OTP_CODE_NOT_FOUND / OTP_CODE_MISMATCH / OTP_CODE_TOO_MANY_ATTEMPTS / OTP_TOO_MANY_ATTEMPTS（红色操作验证码族）、INVARIANT_BALANCE / APPROPRIATENESS_MISMATCH 等不变量违反、REPLAY_DETECTED（重放）。上述每一个错误码都有对应的自动化测试用例（见第九条 9.4）。"] },
      { t: "6.5　模型服务商的角色", ps: ["模型服务商属于受托处理者/独立处理者（依其服务条款而定），其对接收信息的留存与使用受其自身服务协议、合规承诺与适用法律的约束。如你希望对话内容不出站，你可以完全不经由 AI 通道，而仅使用表单通道完成同等业务；两条通道在授权与验证规则上完全同规。"] },
      { t: "6.6　全链路可观察性", ps: ["每一次工具调用的提议内容、IR 编译结果、五道验证的分项结论与最终执行结果均在本平台留痕，并经事件环实时推送至 AI 页的 Trust Console（含 PROPOSED、各道验证、RESULT/BLOCKED 与 CHAT 事件）；该链路同时构成《服务条款》第八条下争议核对的依据。"] },
    ],
  },
  {
    t: "第七条　共享、转让与对外提供",
    ps: ["我们对信息的对外流动采取最严格的限制，并作如下不留余地的承诺："],
    ss: [
      { t: "7.1　不出售", ps: ["我们不出售你的任何个人信息，亦不因营销目的与任何第三方共享你的信息，不进行任何形式的程序化广告或数据经纪活动。"] },
      { t: "7.2　有限的接收方清单", ps: ["除第六条所述模型服务商（对话内容，仅当你使用 AI 通道）与分析类处理者（Google，GA4，仅在你明确同意后启用、以匿名化口径处理、Consent Mode v2 默认 denied）外，本平台不向任何第三方提供可用于识别你身份的信息。前端除 GA4 外无任何第三方脚本、字体或接口请求（字体与图标全部自托管）。"] },
      { t: "7.3　关于数据请求", ps: ["本平台不存在真实身份与真实资金数据，客观上无法响应任何针对真实金融数据的调取请求；如收到此类请求，我们将在核实后如实告知该请求的履行不能，并在合理范围内配合说明本平台的数据结构。"] },
      { t: "7.4　合并、分立与解散", ps: ["本平台为竞赛演示作品，不存在合并、分立、被收购或破产清算等可能引起信息转让的商业情形；竞赛结束后，演示数据可按赛事要求整体保留或删除。"] },
    ],
  },
  {
    t: "第八条　存储地点与保存期限",
    ps: ["我们遵循「实现处理目的所必要的最短时间」原则（参照 PIPL 第十九条）确定各项信息的保存期限，期限届满即删除或匿名化。本条期限与代码中的 TTL 常量一致，可逐项核对。"],
    ss: [
      { t: "8.1　存储地点", ps: ["本平台基础设施部署于 Cloudflare 全球网络：账户数据主要存储于 KV（键值存储，最终一致性读写）与 Durable Object（含 SQLite 账本，强一致、按用户实例隔离）；静态资产存储于 R2 对象存储桶（不含用户数据）；邮件经 Cloudflare Email Service 自 noreply@suveoo.com 发出。物理存储位置由 Cloudflare 依据其数据中心布局与服务配置决定。"] },
      { t: "8.2　分项保存期限", ps: ["（一）邮箱验证码：10 分钟（发送后即有 60 秒重发冷却 cd 标记与小时级 hr 频控计数）；（二）Consent Grant：120 秒（一次性消费后剩余存储缩短至 60 秒内清除）；（三）登录会话令牌：签发后 1 小时，登出即写入吊销列表；（四）两步验证中间令牌：5 分钟；（五）登录失败计数：15 分钟（连续 5 次触发锁定）；（六）对话历史 aihist 与事件环 airing：随会话保留，你可随时发起新会话以隔离上下文；（七）账户、卡片、流水、持仓、收款人、任务、通知：保留至你申请删除或演示周期结束；（八）审计日志与用户级审计：保留至演示周期结束；（九）幂等 nonce 集合：随账户保留（防重放需要）。"] },
      { t: "8.3　期限届满的处理", ps: ["期限届满或处理目的实现后，我们将删除相应信息或对其进行匿名化，使之无法关联到特定个人；因竞赛评审、故障排查等合理需要而适度延长的，我们将采取更严格的访问控制并在文档中记录。"] },
      { t: "8.4　持久性与备份", ps: ["本平台依赖 Cloudflare 平台的持久性能力（KV 与 R2 官方公布的持久性指标），不维护独立的二次备份；你对账户数据享有第十条所列的导出权（月度 PDF 报告，可索取 JSON 全量导出），建议评审与演示用户自行留存导出件。"] },
    ],
  },
  {
    t: "第九条　数据安全措施",
    ps: ["我们参照金融行业通行安全工程实践，从技术与治理两个层面建立安全控制体系，并以自动化对抗测试持续验证其有效性。本条所列每一项控制都有对应的实现位置与测试覆盖。"],
    ss: [
      { t: "9.1　身份与凭据安全", ps: ["密码以 PBKDF2-SHA256（迭代 100,000 次、随机盐、256 位派生）不可逆存储，校验采用常数时间比较；登录连错 5 次锁定 15 分钟；会话以 HMAC-SHA256 签名的短时 JWT（1 小时，含 jti）承载，登出即写入吊销列表（bl:{jti}），任何请求先查吊销再放行；两步验证采用独立短时中间令牌（5 分钟、typ=mfa，不可冒充会话令牌）+ 邮箱验证码。"] },
      { t: "9.2　交易与授权安全", ps: ["Consent Grant 与用户身份绑定（他账户盗用返回 GRANT_NOT_FOUND）、默认 120 秒有效、一次性消费（重放返回 GRANT_ALREADY_USED）；确认环节前后任何参数不一致均导致授权失效（CONSENT_INVALIDATED），且篡改判定优先于 OTP 校验；授权字段实施来源污点追踪（provenance→trust 映射由服务端推导，客户端仅能声明降级、不能自报可信），不可信来源不得进入授权字段；nonce 幂等集防重放；转账执行采用「余额 ≥ 金额 + 已锁资金」的可用额校验；AI 通道另设单笔 ¥5,000、单日 ¥10,000 硬限额。"] },
      { t: "9.3　密钥与配置治理", ps: ["全部密钥（JWT 签名密钥、模型 API Key 等）经平台密钥管理服务（wrangler secret）以加密方式注入运行时，不出现在代码仓库、构建产物或客户端载荷中；演示模式标志（DEMO_MODE）与生产配置显式隔离，故障注入等演示能力仅在演示模式开启时可用。"] },
      { t: "9.4　验证与测试", ps: ["每次发布前运行全量自动化测试套件（当前 117 项，vitest + workerd 真实运行时），其中包含四类对抗场景共 18 个攻击模拟用例：同意篡改（收款人替换、伪造 grant、OTP 途中改参、跨通道篡改）、越权访问（伪造/过期/错类型令牌、跨用户盗用 grant 与读取资源）、重放（表单与 AI 通道 grant 重放、验证码跨用户复用）、提示注入（污点洗白、风控降级走私、指令走私、OCR 来源收款人、金额字符串注入）。对抗测试的结论构成《安全自评估》文档的证据基础。"] },
      { t: "9.5　事件响应", ps: ["安全相关事件经服务端结构化日志（logEvent）与用户级审计双轨留痕；影响你的事件（如登录异常、卡片状态变更）会同步生成站内通知，两步验证开启时并辅以邮件提醒。"] },
      { t: "9.6　残余风险提示", ps: ["尽管已采取上述措施，任何信息系统均不存在绝对安全。本平台已知并接受的风险边界（如 KV 最终一致性窗口、演示环境单区域部署等）在《安全自评估》中如实列明；对于超出合理控制范围的安全事件，我们将按第十条所列渠道及时告知，并配合完成影响评估与处置。"] },
    ],
  },
  {
    t: "第十条　你的权利",
    ps: ["参照 PIPL 第四章与 GDPR 第三章，你就自身个人信息享有以下权利。本平台已将权利行使入口内建于产品功能之中，多数权利可即时自助行使，无需身份证明材料（演示环境以会话即身份）。"],
    ss: [
      { t: "10.1　查阅与复制", ps: ["你可随时在「我的账户」与各功能页查阅个人资料、卡片、流水（支持翻页与日期过滤）、持仓、任务、通知与审计记录，并可通过「月度报告」功能选择月份导出 PDF 格式的账户对账文件（服务端即时生成、经鉴权流交付、不落存储桶）。"] },
      { t: "10.2　更正与补充", ps: ["你可以修改卡片别名、设为默认卡、调整限额、重新完成风险测评、修改登录密码（红色操作，需 OTP）等自助可变更项；如需更正其他信息，可经「联系我们」提出。"] },
      { t: "10.3　删除", ps: ["你可以删除常用收款人、取消订阅与定时任务（取消定时转账任务时自动触发资金解锁补偿）；你可以通过 support@suveoo.com 申请注销账户，届时账户、卡片、流水与持仓数据将被删除。"] },
      { t: "10.4　撤回同意", ps: ["你可以随时在 Cookie 偏好中撤回对分析 Cookie 的同意（页脚「Cookie Preferences」）、在安全中心关闭两步验证。撤回同意不影响撤回前基于同意已进行的处理的效力。"] },
      { t: "10.5　拒绝与限制", ps: ["你可以不使用 AI 通道而仅使用表单通道完成全部业务；可以在任意页面不选择「接受全部」分析 Cookie。本平台不进行个性化推荐与广告投放，故无针对性广告关闭项。"] },
      { t: "10.6　数据可携带性", ps: ["除 PDF 对账文件外，你可经 support@suveoo.com 索取账户数据的 JSON 结构化导出（含资料、卡片、流水、持仓与任务），以便迁移至其他系统（演示语境下即为留存评审材料）。"] },
      { t: "10.7　响应时限", ps: ["我们承诺在验证请求身份后 15 个工作日内响应；演示环境下多数请求即时生效。对无理重复、明显滥用权利的请求，我们保留说明性拒绝的权利。"] },
    ],
  },
  {
    t: "第十一条　未成年人保护",
    ps: ["本平台面向金融科技竞赛评审、行业从业者与成年演示用户设计，不以未成年人为目标用户，亦不设置任何面向未成年人的内容或激励。我们不会主动收集未成年人的个人信息。如你未满 14 周岁，请勿注册或使用本平台；未成年人的监护人发现相关未成年人使用本平台的，可通过第十四条所列渠道联系我们并附简要说明，我们将及时删除相关数据并在合理范围内告知处理结果。"],
  },
  {
    t: "第十二条　政策的变更",
    ps: ["12.1　本政策可能随产品功能、数据流或治理要求的变化而更新。更新后的政策将在本页面发布并同步更新「最近更新」日期；构成重大变更的（如新增信息收集类别、新增共享接收方、变更保存期限），我们将以站内公告等显著方式另行提示。12.2　你在变更发布后继续使用本平台，视为已知悉并接受更新后的政策；对存在实质不利影响的变更，我们将提供合理的事前提示。12.3　历史版本可通过 support@suveoo.com 索取，我们将保留自首次发布以来的主要版本记录。"],
  },
  {
    t: "第十三条　解释与效力",
    ps: ["13.1　本政策的标题仅为阅读便利而设，不影响条款的解释。13.2　本政策任何条款被认定无效或不可执行的，不影响其余条款的效力。13.3　本政策以简体中文版本为准，繁体中文与英文版本仅为评审便利提供；版本间存在歧义的，以简体中文版本为准。13.4　本政策与《服务条款》《Cookie 政策》共同构成你与本平台之间关于信息处理与服务规则的完整约定。13.5　本政策中提及的错误码、字段名与 TTL 数值如与系统实现存在出入，以代码仓库当前实现为准，并欢迎经 security@suveoo.com 指正。"],
  },
  {
    t: "第十四条　联系我们",
    ps: ["14.1　一般咨询与账户事务：support@suveoo.com；14.2　安全事务（含漏洞报告与隐私事件）：security@suveoo.com——对负责任披露的安全问题，我们将在致谢名单中致谢（如你愿意）并说明修复时间线；14.3　我们承诺在收悉后 15 个工作日内回复（演示环境下通常即时响应）。如你对本政策的理解或我们的处理行为存在疑问，欢迎通过上述渠道与我们沟通。"],
  },
];
